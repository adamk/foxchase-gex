[Unit]
Description=Foxchase GEX historical snapshot collector
After=network-online.target mnt-t7.mount foxchase-gex.service
Wants=network-online.target
Requires=foxchase-gex.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/foxchase-gex
EnvironmentFile=/home/pi/foxchase-gex/.env
Environment=FOXCHASE_GEX_DATA_DIR=/mnt/t7/foxchase-gex/archive
Environment=FOXCHASE_GEX_REQUIRED_MOUNT=/mnt/t7
Environment=FOXCHASE_GEX_CAPTURE_SECONDS=60
ExecStart=/home/pi/foxchase-gex/.venv/bin/python -m gex_client.collector
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
