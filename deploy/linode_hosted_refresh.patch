+def _access_token_is_fresh(tokens, now=None):
+    try:
+        epoch = time.time() if now is None else float(now)
+        saved_at = int(tokens.get("saved_at", 0))
+        expires_in = int(tokens.get("expires_in", 1800))
+        refresh_after_age = max(60, expires_in - 120)
+        return bool(tokens.get("access_token")) and epoch - saved_at <= refresh_after_age
+    except (AttributeError, TypeError, ValueError, OverflowError):
+        return False
+
+
+def _log_refresh_event(event, *, reason=None, http_status=None, error_class=None):
+    fields = [
+        f"event={event}",
+        f"pid={os.getpid()}",
+        f"timestamp={datetime.now(timezone.utc).isoformat(timespec='milliseconds')}",
+    ]
+    if reason in {"another_worker_refreshed", "already_fresh"}:
+        fields.append(f"reason={reason}")
+    if http_status is not None:
+        fields.append(f"http_status={int(http_status)}")
+    if error_class is not None:
+        safe_error = (
+            error_class
+            if error_class in {
+                "invalid_grant", "invalid_client", "provider_error", "Timeout",
+                "ConnectionError", "RequestException", "InvalidJSON",
+                "MalformedTokenResponse", "TokenWriteError", "MissingRefreshToken",
+            }
+            else "provider_error"
+        )
+        fields.append(f"error_class={safe_error}")
+    _REFRESH_LOGGER.info("schwab_refresh %s", " ".join(fields))
+
+
