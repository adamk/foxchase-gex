# These values stay on this computer and are never sent to Foxchase.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://127.0.0.1

# Optional overrides
# GEX_ENV=development  # only for local HTTP development; production defaults to Secure cookies
# GEX_OPERATOR_USERNAME=
# GEX_OPERATOR_PASSWORD_HASH=
# GEX_SESSION_SECRET=
# SCHWAB_AUTH_LIFECYCLE_PATH=~/.foxchase-gex/schwab_auth_lifecycle.json
# SCHWAB_TOKEN_PATH=~/.foxchase-gex/schwab_tokens.json
# FOXCHASE_GEX_API_URL=https://gex.foxchasetrading.com/api/community
# FOXCHASE_GEX_PORT=8765
# FOXCHASE_GEX_HOST=127.0.0.1
# FOXCHASE_GEX_DATA_DIR=~/.foxchase-gex/archive
# FOXCHASE_GEX_REQUIRED_MOUNT=
# FOXCHASE_GEX_CAPTURE_SECONDS=60
# FOXCHASE_GEX_FORWARD_AUDIT=1
